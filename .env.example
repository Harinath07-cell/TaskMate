# TaskMate Environment Configuration Template
# Copy this file to .env for local development

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=replace-with-a-random-secret-key-32-chars-minimum

# Database Configuration (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=taskmate_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Database Fallback (set to true to use SQLite if MySQL is unreachable during development)
DB_FALLBACK_SQLITE=true
SQLITE_DB_PATH=taskmate_dev.db

# MongoDB Configuration (Chat conversation logs and user feedback)
MONGODB_URI=mongodb://localhost:27017/taskmate_logs
MONGODB_DATABASE=taskmate_logs

# AI Assistant Configuration (Groq API - Ultra-fast LPU inference)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Fallback AI Configuration (Gemini API)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# CORS & Security
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000

# Rate Limiting (Chatbot requests per minute)
CHAT_RATE_LIMIT=30
